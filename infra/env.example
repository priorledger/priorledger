# /etc/priorledger/env — read by priorledger.service. Not secret, but host-specific: keep it out of the repo.

# The repository working copy the service reads the ledger and site from.
PRIORLEDGER_REPO=/srv/priorledger/repo

# Postgres over the local socket, as the priorledger role (peer authentication, no password).
PRIORLEDGER_DSN=dbname=priorledger

# Listen only on this machine. A reverse proxy or private network reaches it from outside.
PRIORLEDGER_HOST=127.0.0.1
PRIORLEDGER_PORT=8400

# Host headers the MCP endpoint accepts (DNS-rebinding protection). Add the public name at launch.
PRIORLEDGER_ALLOWED_HOSTS=127.0.0.1:*,localhost:*

# Set to 1 only when a reverse proxy in front sets X-Forwarded-For.
PRIORLEDGER_TRUST_PROXY=0

# The public base URL, used in the manifest and llms.txt. Leave empty while private.
PRIORLEDGER_PUBLIC_URL=
