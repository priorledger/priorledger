# /etc/priorledger/env — read by priorledger.service. Host-specific: keep it out of the repo.
# This file holds secrets once filled in: mode 0640, owner root, group priorledger.

# The repository working copy the service reads the ledger and site from.
PRIORLEDGER_REPO=/srv/priorledger/repo

# Postgres over the local socket, as the priorledger role (peer authentication, no password).
PRIORLEDGER_DSN=dbname=priorledger

# Listen only on this machine. A reverse proxy or private network reaches it from outside.
PRIORLEDGER_HOST=127.0.0.1
PRIORLEDGER_PORT=8400

# Host headers the MCP endpoint accepts (DNS-rebinding protection). Add the public name at launch.
PRIORLEDGER_ALLOWED_HOSTS=127.0.0.1:*,localhost:*

# Set to 1 only when a reverse proxy in front sets X-Forwarded-For.
PRIORLEDGER_TRUST_PROXY=0

# The public base URL, used in the manifest and llms.txt. Leave empty while private.
PRIORLEDGER_PUBLIC_URL=

# ---------------------------------------------------------------- steward sign-in (infra/README.md §7)

# Who may sign in to /admin, comma-separated. Only these Google accounts get in.
PRIORLEDGER_STEWARD_EMAILS=
# The OAuth client from Google Cloud for this ledger.
PRIORLEDGER_GOOGLE_CLIENT_ID=
PRIORLEDGER_GOOGLE_CLIENT_SECRET=
# Where the steward opens /admin from; Google redirects back to <this>/admin/auth/callback.
PRIORLEDGER_ADMIN_URL=http://localhost:8400
# Signs session cookies. install.sh fills this in with a random value on first run.
PRIORLEDGER_SECRET=
# Optional: only answer /admin and /api/steward on these host names (e.g. a private one).
PRIORLEDGER_ADMIN_HOSTS=
# The handle shown on entries the steward writes from the portal.
PRIORLEDGER_STEWARD_HANDLE=first-prior

# ---------------------------------------------------------------- publishing (infra/README.md §8)

# none: accepted entries wait in the working copy for a manual commit and push.
# git:  accepting commits as the project identity and pushes with the deploy key.
PRIORLEDGER_PUBLISH=none
PRIORLEDGER_GIT_NAME=first prior
PRIORLEDGER_GIT_EMAIL=priorledger@gmail.com
GIT_SSH_COMMAND=ssh -i /srv/priorledger/.ssh/deploy_key -o IdentitiesOnly=yes -o UserKnownHostsFile=/srv/priorledger/.ssh/known_hosts
